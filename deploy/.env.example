# UWC — переменные окружения продакшена
# Скопировать в .env (или заполнить прямо в ecosystem.config.cjs / systemd unit)

# Публичный адрес сайта (canonical, sitemap, og:url)
NUXT_PUBLIC_SITE_URL=https://uwc.rsh.pw

# Порт Node-сервера (Caddy проксирует на него)
PORT=4000

# Лимиты серверной конвертации
NUXT_MAX_INPUT_MB=50
NUXT_CONVERT_TIMEOUT_MS=15000
